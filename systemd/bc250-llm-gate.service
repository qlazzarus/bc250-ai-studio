[Unit]
Description=BC-250 LLM admission gate
After=network.target

[Service]
Type=simple
User=ai-studio
Group=ai-studio
WorkingDirectory=/opt/bc250-ai-studio
EnvironmentFile=/etc/bc250-llm-gate.env
ExecStart=/opt/bc250-ai-studio/.venv/bin/uvicorn app.gate:create_gate_app --factory --host 127.0.0.1 --port 8081 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
