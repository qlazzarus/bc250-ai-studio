# Copy through the secret-generation procedure in docs/DEPLOYMENT.md.
# systemd EnvironmentFile, not a shell script. Never commit the populated file.
STUDIO_API_KEY=GENERATE_CLIENT_KEY
STUDIO_ADMIN_KEY=GENERATE_ADMIN_KEY
STUDIO_DATA_DIR=/opt/ai-studio-data
STUDIO_REGISTRY_PATH=/opt/bc250-ai-studio/config/models.yaml
STUDIO_ENGINE=fake
STUDIO_POLICY=image_priority
STUDIO_CORS_ORIGINS=[]
STUDIO_GPU_TEST_APPROVED=false
STUDIO_GPU_LOCK_PATH=/run/bc250-ai-studio/gpu.lock
# Real engine: only after gate + polkit validation.
