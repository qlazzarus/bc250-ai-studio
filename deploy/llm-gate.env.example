# New gate service only. Do not reuse Studio API client/admin keys.
# Existing RP/LLM clients must use http://BC250_HOST:8081 after validation.
GATE_API_KEY=GENERATE_GATE_CONTROL_KEY
GATE_UPSTREAM_URL=http://127.0.0.1:8080
GATE_PROXY_TIMEOUT=900
# Coordinated migration only; use three distinct long random secrets.
# GATE_OWNED_CONTROL=true
# GATE_STATE_PATH=/var/lib/bc250-llm-gate/holds.json
# GATE_STUDIO_KEY=<same secret as STUDIO_ADMISSION_KEY>
# GATE_SWITCH_KEY=<same secret stored in the root-only switch-gate-key file>
